{
    "name": "infrangible/m2-catalog-filter-sorter",
    "description": "Shows the product sort options as a \"Sort By\" group inside the layered navigation, so shoppers sort and filter in one place.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Layered navigation",
        "Catalog",
        "Hyvä",
        "sort options in layered navigation",
        "sort by in the filter sidebar"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-filter-sorter",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "infrangible/m2-core": "~5.0.5",
        "infrangible/m2-foundation": "~3.0.1",
        "infrangible/m2-layout-update": "~2.0.0",
        "magento/framework": "~103.0.6",
        "magento/module-catalog": "~104.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-store": "~101.1.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogFilterSorter\\": "src"
        }
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    }
}
