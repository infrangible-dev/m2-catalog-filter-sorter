{
    "name": "infrangible/m2-catalog-filter-sorter",
    "description": "Shows the product sort options as a \"Sort By\" group inside the layered navigation, so shoppers sort and filter in one place.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Layered navigation",
        "Catalog",
        "Hyvä",
        "sort options in layered navigation",
        "sort by in the filter sidebar"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-filter-sorter",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-layout-update": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogFilterSorter\\": "src"
        }
    }
}
